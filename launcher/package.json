{
  "name": "emberfall-vale",
  "productName": "Emberfall Vale",
  "version": "1.1.0",
  "description": "Launcher for Emberfall Vale",
  "author": "VisrealSinan",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-game": "node scripts/prepare-game.js",
    "start": "npm run prepare-game && electron .",
    "dist": "npm run prepare-game && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.visrealsinan.emberfallvale",
    "productName": "Emberfall Vale",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "localize.js",
      "package.json",
      "ui/**",
      "game/**",
      "fonts/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Emberfall Vale",
      "artifactName": "EmberfallVale-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EmberfallVale-Portable-${version}.${ext}"
    }
  }
}
